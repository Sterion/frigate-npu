+    --mount=type=bind,source=docker/main/install_ppa.sh,target=/deps/install_ppa.sh \
     /deps/install_deps.sh
 
 ENV DEFAULT_FFMPEG_VERSION="8.0"
@@ -270,10 +279,10 @@ ENV INCLUDED_FFMPEG_VERSIONS="${DEFAULT_FFMPEG_VERSION}:7.0:5.0"
 
 RUN wget -q https://bootstrap.pypa.io/get-pip.py -O get-pip.py \
     && sed -i 's/args.append("setuptools")/args.append("setuptools==77.0.3")/' get-pip.py \
-    && python3 get-pip.py "pip"
+    && python3 get-pip.py "pip" --ignore-installed
 
 RUN --mount=type=bind,from=wheels,source=/wheels,target=/deps/wheels \
-    pip3 install -U /deps/wheels/*.whl
+    pip3 install -U --ignore-installed /deps/wheels/*.whl
 
 # Install Axera Engine
