diff --git a/docker/main/install_ppa.sh b/docker/main/install_ppa.sh
new file mode 100755
index 0000000..802ed36
--- /dev/null
+++ b/docker/main/install_ppa.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+
+# Usage: install_ppa.sh <owner/ppa> <signing key fingerprint>
+# With PPA_SNAPSHOT set (e.g. 20261020T000000Z) the PPA is read as it was then.
+
+set -euxo pipefail
+
+ppa=$1
+fingerprint=$2
+name=${ppa//\//-}
+
+source /etc/os-release
+
+if [[ -n "${PPA_SNAPSHOT:-}" ]]; then
+    url="https://snapshot.ppa.launchpadcontent.net/${ppa}/ubuntu/${PPA_SNAPSHOT}"
+else
+    url="https://ppa.launchpadcontent.net/${ppa}/ubuntu"
+fi
+
+wget -qO "/tmp/${name}.asc" "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0x${fingerprint}"
+if ! gpg --show-keys --with-colons "/tmp/${name}.asc" | grep -qx "fpr:::::::::${fingerprint}:"; then
+    echo "key for ${ppa} does not have fingerprint ${fingerprint}" >&2
+    exit 1
+fi
+gpg --dearmor < "/tmp/${name}.asc" > "/usr/share/keyrings/${name}.gpg"
+rm "/tmp/${name}.asc"
+
+echo "deb [signed-by=/usr/share/keyrings/${name}.gpg] ${url} ${VERSION_CODENAME} main" > "/etc/apt/sources.list.d/${name}.list"
