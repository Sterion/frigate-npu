@@ -157,15 +160,19 @@ FROM base AS wheels
 ARG DEBIAN_FRONTEND
 ARG TARGETARCH
 ARG DEBUG=false
+ARG PPA_SNAPSHOT
 
 # Use a separate container to build wheels to prevent build dependencies in final image
-RUN apt-get -qq update \
+RUN --mount=type=bind,source=docker/main/install_ppa.sh,target=/deps/install_ppa.sh \
+    apt-get -qq update \
     && apt-get -qq install -y \
-    apt-transport-https wget unzip \
+    apt-transport-https wget unzip gnupg ca-certificates \
+    && /deps/install_ppa.sh deadsnakes/ppa F23C5A6CF475977595C89F51BA6932366A755776 \
     && apt-get -qq update \
     && apt-get -qq install -y \
     python3.11 \
     python3.11-dev \
+    python3.11-distutils \
     # opencv dependencies
     build-essential cmake git pkg-config libgtk-3-dev \
     libavcodec-dev libavformat-dev libswscale-dev libv4l-dev \
@@ -183,7 +190,7 @@ RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
 
 RUN wget -q https://bootstrap.pypa.io/get-pip.py -O get-pip.py \
     && sed -i 's/args.append("setuptools")/args.append("setuptools==77.0.3")/' get-pip.py \
-    && python3 get-pip.py "pip"
+    && python3 get-pip.py "pip" --ignore-installed
 
